<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!--
      Sqlite is the primary test DB provider (DbContextFactory.Create) — a real relational
      provider that validates SQL translatability. The vulnerable native lib
      SQLitePCLRaw.lib.e_sqlite3 2.1.11 (SQLite < 3.50.2) is remediated centrally in
      Directory.Packages.props by pinning the transitive SQLitePCLRaw bundle + core to the
      3.0.x line, which ships SourceGear.sqlite3 (SQLite >= 3.50.2) instead. Test-only — the
      app uses Npgsql.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ApexRacers.Api\ApexRacers.Api.csproj" />
    <ProjectReference Include="..\ApexRacers.Ingestion\ApexRacers.Ingestion.csproj" />
    <ProjectReference Include="..\ApexRacers.Seeder\ApexRacers.Seeder.csproj" />
  </ItemGroup>
</Project>
