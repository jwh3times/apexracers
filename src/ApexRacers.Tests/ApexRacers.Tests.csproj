<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!--
      Sqlite is the primary test DB provider (DbContextFactory.Create) — a real relational
      provider that validates SQL translatability. Its transitive native lib
      SQLitePCLRaw.lib.e_sqlite3 currently has advisory NU1903; it is accepted here because
      (a) this is a test-only dependency never shipped to production (the app uses Npgsql),
      (b) the advisory requires opening a malicious database file and our tests only ever
      create their own in-memory databases from trusted code, and (c) no patched version is
      published yet — Dependabot will bump it when one ships.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ApexRacers.Api\ApexRacers.Api.csproj" />
    <ProjectReference Include="..\ApexRacers.Ingestion\ApexRacers.Ingestion.csproj" />
  </ItemGroup>
</Project>
