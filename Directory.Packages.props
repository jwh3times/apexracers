<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Also override transitive package versions. Without this, Npgsql 10.0.1
      pulls EF Core 10.0.4 as a transitive dep even though we declare 10.0.7
      above — causing CS1705 when a project references ApexRacers.Data (which
      compiled against 10.0.7 via the Design package).
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Pin the entire EF Core family to the same patch so projects that reference
      each other never see split assembly versions (e.g. Npgsql 10.0.1 brings
      EF Core 10.0.4 but Microsoft.EntityFrameworkCore.Design 10.0.7 requires
      10.0.7 — without a common floor that produces MSB3277 warnings).
    -->
    <PackageVersion Include="Aydsko.iRacingData" Version="2603.0.0" />
    <PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.18" />
    <!-- Test packages -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!--
      Transitive pin (CentralPackageTransitivePinningEnabled) to remediate the
      SQLitePCLRaw.lib.e_sqlite3 advisory (SQLite < 3.50.2 memory corruption).
      EF Core 10.0.9's Sqlite provider pulls SQLitePCLRaw.bundle_e_sqlite3 + .core 2.1.11,
      and lib.e_sqlite3 is stuck at 2.1.11 (no patched 2.1.x exists). SQLitePCLRaw 3.0.x is
      an API-compatible repackaging that replaces lib.e_sqlite3 with SourceGear.sqlite3
      (>= 3.50.4.5, i.e. SQLite >= 3.50.2 — patched), so pinning the bundle + core to 3.0.x
      drops the vulnerable native package from the graph. Sqlite is test-only here (the app
      uses Npgsql), so this only affects ApexRacers.Tests.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.3" />
  </ItemGroup>
</Project>
