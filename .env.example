# ─── Secrets (stored in Azure Key Vault) ─────────────────────────────────────
# The following are NOT stored here. Add them as secrets in Key Vault using
# hyphenated names: IRACING-USERNAME, IRACING-PASSWORD, IRACING-CLIENT-ID,
# IRACING-CLIENT-SECRET, DATABASE-CONNECTION-STRING.
#
# For local development, run `az login` once — DefaultAzureCredential will
# authenticate to Key Vault automatically. No secrets on disk required.

# ─── docker-compose local overrides ──────────────────────────────────────────
# These are only used by docker-compose to initialise the local Postgres
# container. They are NOT read by the .NET projects.
POSTGRES_PASSWORD=devpassword
PGADMIN_PASSWORD=admin

# ─── Ingestion worker ─────────────────────────────────────────────────────────
INGESTION_INTERVAL_MINUTES=60

# ─── OAuth redirect (not a secret — used only when AuthController is wired up) ─
OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/callback
