# ─── iRacing OAuth 2.0 — Authorization Code Flow (user-facing sign-in) ───────
# Credentials must be requested directly from iRacing. There is no self-service
# developer portal. Contact iRacing support to request OAuth API access.
IRACING_CLIENT_ID=
IRACING_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/callback

# ─── iRacing Password Limited Flow (ingestion worker only) ───────────────────
# A dedicated iRacing service account is recommended for the worker process.
IRACING_USERNAME=
IRACING_PASSWORD=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=apexracers;Username=apexracers;Password=devpassword

# ─── Ingestion worker ─────────────────────────────────────────────────────────
# How many minutes between ingestion cycles.
INGESTION_INTERVAL_MINUTES=60

# ─── docker-compose local overrides ──────────────────────────────────────────
POSTGRES_PASSWORD=devpassword
PGADMIN_PASSWORD=admin
