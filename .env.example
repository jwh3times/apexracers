# ─── Secrets (stored in Azure Key Vault) ─────────────────────────────────────
# In the deployed environment the following are NOT stored here. They are secrets
# in Key Vault under hyphenated names: IRACING-USERNAME, IRACING-PASSWORD,
# IRACING-CLIENT-ID, IRACING-CLIENT-SECRET, DATABASE-CONNECTION-STRING,
# JWT-SIGNING-KEY. HyphenToUnderscoreSecretManager maps each to the underscored
# variable the code reads.
#
# Key Vault is only consulted when AZURE_KEY_VAULT_URL is set (see below) — it is
# NOT a silent fallback. With that variable unset, which is the default for local
# development, every value below must come from this file or the environment.
#
# For local development: copy this file to .env and fill in the values marked
# "Required". The defaults for everything else match the docker-compose stack.

# ─── Azure Key Vault (optional; unset for local development) ─────────────────
# When set, the API and the ingestion worker load configuration from this vault
# via DefaultAzureCredential — run `az login` once so that credential resolves.
# Leave it unset to read everything from this file instead.
# AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net/

# ─── docker-compose local overrides ──────────────────────────────────────────
# These are only used by docker-compose to initialise the local Postgres
# container. They are NOT read by the .NET projects.
POSTGRES_PASSWORD=devpassword
PGADMIN_PASSWORD=admin

# ─── docker-compose host ports ───────────────────────────────────────────────
# Host-side ports for the local stack. Only the host mapping moves — container
# ports (and therefore the Azure image) never change. ApexRacers owns the
# canonical defaults; shift these if you run another project's stack at the same
# time (see the fleet port lanes in README.md → Ports).
POSTGRES_PORT=5432
PGADMIN_PORT=5050
API_PORT=8080

# ─── Database connection ──────────────────────────────────────────────────────
# Required — the API and the ingestion worker both refuse to start without it, and
# docker-compose passes it through with NO default, so an unset value reaches the
# container empty rather than falling back to anything.
#
# Pre-filled for the compose stack: the host is the `postgres` SERVICE name, not
# localhost, because the API container resolves it over the compose network. If you
# change POSTGRES_PASSWORD above, change the password here to match.
#
# Running the API on the host instead (`dotnet run --project src/ApexRacers.Api`,
# `npm run dev`)? Swap the host for localhost and the port for whatever
# POSTGRES_PORT is set to above — note that nothing expands a ${VAR} reference in
# this file, so write the literal value:
#   Host=localhost;Port=5432;Database=apexracers;Username=apexracers;Password=devpassword
# That line is also the fallback the Seeder and the EF design-time factory use when
# this variable is unset entirely.
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=apexracers;Username=apexracers;Password=devpassword

# ─── API bearer-token signing key ─────────────────────────────────────────────
# Required — the API refuses to start without it. In Azure this comes from Key
# Vault as JWT-SIGNING-KEY; for local docker-compose set it here.
#
# Must be at least 32 bytes (256 bits): tokens are signed with HMAC-SHA256, so a
# key shorter than the digest is the weakest link and is brute-forceable offline
# from a single captured token. Startup fails with the measured length if it is
# short. Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=

# ─── iRacing Data API credentials ─────────────────────────────────────────────
# Consumed by BOTH the ingestion worker AND the API (the API now makes on-demand
# per-user fetches in addition to the worker's bulk pulls). In Azure these come
# from Key Vault (IRACING-* secrets noted above); for local docker-compose set
# them here. The API boots without them — live-data endpoints return 503 until
# all four are present.
IRACING_USERNAME=
IRACING_PASSWORD=
IRACING_CLIENT_ID=
IRACING_CLIENT_SECRET=

# ─── Ingestion worker ─────────────────────────────────────────────────────────
INGESTION_INTERVAL_MINUTES=60

# ─── API per-IP rate limits ───────────────────────────────────────────────────
# docker-compose already defaults these to 1000 / 10000 so the local E2E loop
# (`docker compose up` + `npm run test:e2e`) isn't throttled — the whole serial
# suite hits the API from one loopback IP, and the production defaults (auth
# 10/min, global 300/min) run out partway through, failing tests for reasons
# that look nothing like rate limiting. Uncomment to exercise the limiter itself.
# AUTH_RATE_LIMIT_PERMIT_PER_MINUTE=10
# GLOBAL_RATE_LIMIT_PERMIT_PER_MINUTE=300
#
# Per-*user* window on driver search — the one iRacing-backed route taking free text, where each
# distinct term is a distinct upstream fetch against the shared service-account quota. Default 30.
# SEARCH_RATE_LIMIT_PERMIT_PER_MINUTE=30

# ─── Sign-in throttle ─────────────────────────────────────────────────────────
# Brute-force protection on sign-in, counted per (account, source address) rather than per account.
# The per-account form used to mean five requests from a stranger locked a Driver out of their own
# account for the window, repeatable indefinitely (issue #300); scoping to the address means a
# guesser exhausts only their own.
#
# Crossing the account-wide high-water mark does NOT deny anyone — it shrinks every address's
# allowance to the tightened value, so distributed guessing gets one attempt per address while an
# address that has not failed is still admitted on the first correct password. Keep the tightened
# value at 1 or more: 0 would deny the owner too, rebuilding the denial of service.
#
# Defaults shown; uncomment to change. Unlike the per-IP rate limits above, these need no CI/E2E
# override: the counter is scoped to (account, address), and each E2E test registers its own fresh
# account, so one test exhausting an allowance cannot throttle the next. Only raise these to
# exercise the throttle itself.
# SIGNIN_MAX_FAILURES_PER_ADDRESS=5
# SIGNIN_MAX_FAILURES_PER_ADDRESS_UNDER_ATTACK=1
# SIGNIN_ACCOUNT_HIGH_WATER_FAILURES=50
# SIGNIN_ADDRESS_WINDOW_MINUTES=15
# SIGNIN_ACCOUNT_WINDOW_MINUTES=60
#
# Shortest gap between two "failed sign-in attempts" emails to one account. A rate limit, not a
# preference: sign-in is unauthenticated, so an email per lockout is an inbox a stranger can fill.
# SIGNIN_NOTICE_INTERVAL_MINUTES=60

# ─── JWT issuer and audience ──────────────────────────────────────────────────
# Both sides of the token contract are bound once as JwtSettings, which builds the
# issuing credentials and the validating parameters from the same values — so these
# must match across every instance that issues or accepts a token. Defaults shown;
# uncomment only to change them.
# JWT_ISSUER=ApexRacers.Api
# JWT_AUDIENCE=ApexRacers.Web

# ─── Admin bootstrap ──────────────────────────────────────────────────────────
# Comma-separated account emails promoted to Admin at API startup. Promotion
# requires the account to exist AND to have a CONFIRMED email — unconfirmed or
# missing accounts are skipped, not created. Register the account first, confirm
# the address, then start the API with this set.
# ADMIN_SEED_EMAILS=you@example.com

# ─── Account email links ──────────────────────────────────────────────────────
# Origin used to build confirmation, password-reset, and email-change links.
# Defaults to https://apexracers.gg, which is wrong for local development — set it
# to wherever you actually browse the app, or the links in your mail will point at
# production.
# APP_BASE_URL=http://localhost:5173

# ─── Transactional email delivery ─────────────────────────────────────────────
# Exactly one sender binds, chosen in this order by EmailDelivery.Select:
#
#   1. DEV_MAIL_DROP_PATH — a directory; each outbound email is written there as
#      JSON instead of being sent. Development ONLY: startup FAILS if it is set in
#      any other environment, so this never silently swallows production mail.
#      This is the easiest way to read a confirmation link locally.
#   2. ACS_CONNECTION_STRING — Azure Communication Services; real delivery.
#   3. Neither set — subjects are logged and nothing is sent.
#
# DEV_MAIL_DROP_PATH=./tmp/mail
# ACS_CONNECTION_STRING=
# ACS_SENDER_ADDRESS=noreply@apexracers.gg

# ─── Reverse-proxy forwarded headers ──────────────────────────────────────────
# Set to "true" ONLY when the app runs behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Forwarded-Proto (the deployed App Service does). It makes
# per-IP rate limiting and the sign-in throttle read the real client address, and
# HSTS see the client's scheme.
#
# Leave it unset locally. Enabling it without a proxy in front lets any caller
# spoof their own source address through a request header, which would defeat both
# the rate limiter and the sign-in throttle.
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
