{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch *)",
      "Bash(gh project item-list *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(gh label list *)",
      "Bash(gh project field-list *)",
      "Bash(gh project view *)",
      "Bash(az containerapp show *)",
      "Bash(gh run watch *)",
      "Bash(az monitor app-insights query *)",
      "Bash(az monitor metrics list *)",
      "mcp__microsoft-learn__microsoft_docs_search",
      "Bash(npx oxlint .)",
      "Bash(az monitor log-analytics query *)",
      "Bash(az containerapp replica list *)",
      "Bash(az containerapp revision list *)",
      "Bash(npx prettier --check *)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id",
      "Bash(az account show *)",
      "Bash(docker info)",
      "Bash(gh secret list *)",
      "Bash(az monitor app-insights component show *)",
      "Bash(az monitor app-insights component quotastatus show *)",
      "Bash(az storage account show *)",
      "Bash(az role assignment list *)",
      "Bash(az storage container-rm show *)",
      "Bash(az postgres flexible-server show *)",
      "Bash(az webapp show *)",
      "Bash(az appservice plan show *)",
      "Bash(az ad signed-in-user show *)",
      "Bash(az monitor log-analytics workspace show *)",
      "Bash(az role definition list *)",
      "Bash(az acr show *)",
      "Bash(az containerapp env show *)",
      "Bash(az webapp config ssl list *)",
      "Bash(az keyvault show *)",
      "Bash(az storage container-rm list *)",
      "Bash(az provider show *)",
      "Bash(az storage account blob-service-properties show *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard.mjs",
              "--post"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
